# Supabase → Project Settings → Database.
# Session pooler or direct connection, port 5432.
# Do not use the transaction pooler on port 6543.
DB_HOST=aws-0-eu-west-3.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_SSL_MODE=require

OTOMOTO_MAKES=audi,bmw,ford,volkswagen,mercedes-benz,opel,toyota,skoda

INGEST_ENABLED=false
INGEST_MIN_DELAY=3m
INGEST_MAX_DELAY=5m
INGEST_TOKEN=change-me
